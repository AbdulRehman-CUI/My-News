# Optional. Set in PowerShell before startup; this file is not loaded automatically.
# If omitted, a random session secret is stored locally in ignored instance/secret.key.
MYNEWS_SECRET_KEY=replace-with-a-random-local-secret
# Optional server-side key for TheNewsAPI /v1/news/top and /v1/news/all.
THENEWSAPI_KEY=replace-with-a-local-key
# Optional JSON object mapping RSS/Atom URLs to MyNews topics.
# MYNEWS_RSS_FEEDS={"https://example.com/feed.xml":["Technology"]}
