# Optional. Set in PowerShell before startup; this file is not loaded automatically.
# If omitted, a random session secret is stored locally in ignored instance/secret.key.
MYNEWS_SECRET_KEY=replace-with-a-random-local-secret
# Optional server-side key for TheNewsAPI /v1/news/top and /v1/news/all.
THENEWSAPI_KEY=replace-with-your-server-side-key
# Optional for local development. Set this to the Neon connection string in Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Required when DATABASE_URL is set. Never use this placeholder.
MYNEWS_ALLOWED_HOSTS=mynews.vercel.app
# Existing server-side Vercel cron bearer secret; never commit its real value.
# Required for /api/cron/ingest and /api/admin/ingestion. Missing means deny access.
# CRON_SECRET=load-your-existing-secret-from-your-secret-manager
# Optional JSON object mapping RSS/Atom URLs to MyNews topics.
# MYNEWS_RSS_FEEDS={"https://example.com/feed.xml":["Technology"]}
