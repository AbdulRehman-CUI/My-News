{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,.tmp/**,tests/**,models/**,generated/**,instance/**,.cache/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 4 * * *"
    }
  ]
}
